configfile: "workflow/lumpings.yml"

import os


def get_d(wildcards):
  return config[wildcards.lumping]["kernel similarity"]

def get_g(wildcards):
  return config[wildcards.lumping]["feature kernel"]

def get_top_file(wildcards):
  configfile: "data/" + wildcards.system + "/input/config.yml"
  return config["source"] + config["topology file"]

def get_xtc_file(wildcards):
  configfile: "data/" + wildcards.system + "/input/config.yml"
  return config["source"] + config["xtc file"]

def get_contact_index_file(wildcards):
  configfile: "data/" + wildcards.system + "/input/config.yml"
  if "contact index file" in config:
    return os.path.join(config["source"], config["contact index file"])
  else:
    return "none"

def get_mem_mb(wildcards):
  configfile: "data/" + wildcards.system + "/input/config.yml"
  return os.path.getsize(os.path.join(config["source"], config["xtc file"])) / 1e6 + 500

rule gen_Z:
  input:
    "data/{system}/input/config.yml",
  output:
    "data/{system}/results/{lumping}/Z.npy"
  params:
    d=get_d,
    g=get_g
  conda:
    "mpp"
  cache: True
  shell:
    "python -m MPP.run {input} {params.d} {params.g} -Z {output}"

rule plot_png:
  input:
    config="data/{system}/input/config.yml",
    z="data/{system}/results/{lumping}/Z.npy"
  output:
    "data/{system}/results/{lumping}/{plot}.png"
    # report(
    #     "data/{system}/results/{lumping}/{plot}.png",
    #     caption="report/plot.rst",
    #     category="{system}",
    #     subcategory="{lumping}",
    #     labels={
    #         "System": "{system}",
    #         "Plot": "{plot}",
    #       }
    #     )
  params:
    d=get_d,
    g=get_g
  resources:
    mem_mb=get_mem_mb
  conda:
    "mpp"
    # "mpp.yml"
  shell:
    "python -m MPP.run {input.config} {params.d} {params.g} -Z {input.z} -p {wildcards.plot} -o {output}"

rule plot:
  input:
    config="data/{system}/input/config.yml",
    z="data/{system}/results/{lumping}/Z.npy"
  output:
    "data/{system}/results/{lumping}/{plot}.pdf"
    # report(
    #     "data/{system}/results/{lumping}/{plot}.pdf",
    #     category="{system}",
    #     subcategory="{lumping}",
    #     labels={
    #         "System": "{system}",
    #         "Plot": "{plot}",
    #       }
    #     )
  params:
    d=get_d,
    g=get_g
  conda:
    "mpp"
    # "mpp.yml"
  shell:
    "python -m MPP.run {input.config} {params.d} {params.g} -Z {input.z} -p {wildcards.plot} -o {output}"

rule rmsd:
  input:
    config="data/{system}/input/config.yml",
    z="data/{system}/results/{lumping}/Z.npy"
  output:
    npy="data/{system}/results/{lumping}/rmsd.npy",
    pdb="data/{system}/results/{lumping}/rmsd_mean_frames.ndx"
  params:
    d=get_d,
    g=get_g
  resources:
    mem_mb=get_mem_mb
  conda:
    "mpp"
    # "mpp.yml"
  shell:
    "python -m MPP.run {input.config} {params.d} {params.g} -Z {input.z} --rmsd {output.npy}"

checkpoint draw_random:
  input:
    config="data/{system}/input/config.yml",
    z="data/{system}/results/{lumping}/Z.npy"
  output:
    macrostates=directory("data/{system}/results/{lumping}/random_frames/")
  params:
    d=get_d,
    g=get_g,
    n=20
  conda:
    "mpp"
    # "mpp.yml"
  shell:
    "python -m MPP.run {input.config} {params.d} {params.g} -Z {input.z} -r {params.n} -o {output}"

rule get_random_pdb_frames:
  input:
    "data/{system}/results/{lumping}/random_frames/{macrostate}.ndx"
  output:
    "data/{system}/results/{lumping}/random_pdbs/{macrostate}.pdb"
  params:
    top=get_top_file,
    xtc=get_xtc_file,
  shell:
    """mkdir -p random_pdbs
gmx trjconv -s {params.top} -f {params.xtc} -o {output} -fr {input} <<eof
0
eof"""

rule get_mean_frames_pdb:
  input:
    "data/{system}/results/{lumping}/rmsd_mean_frames.ndx"
  output:
    "data/{system}/results/{lumping}/mean_frames.pdb"
  params:
    top=get_top_file,
    xtc=get_xtc_file,
  shell:
    """mkdir -p random_pdbs
gmx trjconv -s {params.top} -f {params.xtc} -o {output} -fr {input} <<eof
0
eof"""

rule render_pdb_files:
  input:
    pdb="data/{system}/results/{lumping}/random_pdbs/{macrostate}.pdb",
    ndx="data/{system}/results/{lumping}/least_moving_residues.ndx",
  output:
    "data/{system}/results/{lumping}/random_pngs/{macrostate}.png"
  conda:
    "pymol"
  params:
    ndx_file=get_contact_index_file,
  shell:
    # "mkdir -p random_pngs; pymol -cq workflow/scripts/render_random_structures.py -- {input.pdb} {output} {input.ndx}"
    "pymol -cq workflow/render_random_structures.py -- {input.pdb} {output} {input.ndx}"

def aggregate_input(wildcards):
    checkpoint_output = checkpoints.draw_random.get(**wildcards).output[0]
    return expand("data/{system}/results/{lumping}/random_pngs/{macrostate}.png",
           system=wildcards.system,
           lumping=wildcards.lumping,
           macrostate=glob_wildcards(os.path.join(checkpoint_output, "{macrostate}.ndx")).macrostate)

def aggregate_input_pdb(wildcards):
    checkpoint_output = checkpoints.draw_random.get(**wildcards).output[0]
    return expand("data/{system}/results/{lumping}/random_pdbs/{macrostate}.pdb",
           system=wildcards.system,
           lumping=wildcards.lumping,
           macrostate=glob_wildcards(os.path.join(checkpoint_output, "{macrostate}.ndx")).macrostate)

rule aggregate:
  input:
    aggregate_input
  output:
    "data/{system}/results/{lumping}/macrostates.txt"
  shell:
    "echo {input} > {output}"

rule aggregate_pdb:
  input:
    aggregate_input_pdb
  output:
    "data/{system}/results/{lumping}/macrostates_pdb.txt"
  shell:
    "echo {input} > {output}"


rule get_least_moving_residues:
  input:
    config="data/{system}/input/config.yml",
    z="data/{system}/results/{lumping}/Z.npy"
  output:
    "data/{system}/results/{lumping}/least_moving_residues.ndx"
  params:
    d=get_d,
    g=get_g,
    ndx_file=get_contact_index_file,
  conda:
    "mpp"
  shell:
    "python -m MPP.run {input.config} {params.d} {params.g} -Z {input.z} -o {output} --get-least-moving-residues {params.ndx_file}"





rule report:
  input:
    "data/{system}/results/{lumping}/sankey.pdf",
    "data/{system}/results/{lumping}/dendrogram.pdf",
    "data/{system}/results/{lumping}/ck_test.pdf",
    "data/{system}/results/{lumping}/timescales.pdf",
    "data/{system}/results/{lumping}/contacts.pdf",
    "data/{system}/results/{lumping}/macrotraj.pdf",
  output:
    "data/{system}/results/{lumping}/report.tex",
  conda:
    "mpp"
  shell:
    "python workflow/report.py {wildcards.system} {wildcards.lumping}"

rule report_rmsd:
  input:
    "data/{system}/results/{lumping}/sankey.pdf",
    "data/{system}/results/{lumping}/dendrogram.pdf",
    "data/{system}/results/{lumping}/ck_test.pdf",
    "data/{system}/results/{lumping}/timescales.pdf",
    "data/{system}/results/{lumping}/contacts.pdf",
    "data/{system}/results/{lumping}/macrotraj.pdf",
    "data/{system}/results/{lumping}/rmsd.pdf",
  output:
    "data/{system}/results/{lumping}/report_rmsd.tex",
  conda:
    "mpp"
  shell:
    "python workflow/report.py {wildcards.system} {wildcards.lumping} -r"
